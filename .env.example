# Neon Postgres connection string (Dashboard → Connect).
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional absolute site URL used when generating share links on the server.
# If unset, the browser origin is used instead.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
